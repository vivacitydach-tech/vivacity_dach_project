# Copy to .env.docker and adjust for your VPS / laptop
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=middleware_prod
MYSQL_USER=target
MYSQL_PASSWORD=targetpass
MYSQL_HOST_PORT=3307

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=7d
JWT_REFRESH_TTL=30d

# Browser-facing API URL (used by Next + mobile builds)
NEXT_PUBLIC_API_URL=http://localhost:3000/v1
VITE_API_URL=http://localhost:3000/v1
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost

UPSTREAM_MODE=http
COST_CORE_BASE_URL=http://cost-core:8069
PM_CORE_BASE_URL=http://pm-core:8080
REDIS_URL=redis://redis:6379

RUN_SEED=true
API_HOST_PORT=3000
WEB_HOST_PORT=3001
MOBILE_HOST_PORT=3002
GATEWAY_HOST_PORT=80

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
