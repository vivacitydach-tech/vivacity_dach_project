# Database (XAMPP MySQL)
DATABASE_URL="mysql://root@localhost:3306/middleware_prod"

# Auth
JWT_SECRET="target-enterprise-dev-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:3001,http://localhost:3002"
UPLOAD_DIR="./uploads"

# Upstream mode: mock | http | hybrid
# mock  = in-process mock adapters (default, no engines required)
# http  = use COST_CORE_BASE_URL / PM_CORE_BASE_URL when set
# hybrid = prefer HTTP when URL set, else mock
UPSTREAM_MODE=http
MOCK_UPSTREAM_OUTAGE=false

# Local headless engines (../cost-core :8069, ../pm-core :8080)
# Start with: ..\scripts\start-engines.ps1
# Or Docker official images: cd ..\const-infra && docker compose --profile official up -d
# (official profile REPLACES local engines on the same ports — do not run both)
COST_CORE_BASE_URL=http://127.0.0.1:8069
COST_CORE_API_TOKEN=
PM_CORE_BASE_URL=http://127.0.0.1:8080
PM_CORE_API_TOKEN=

# BullMQ / Redis 7 (spec §8 / §10) — start via:
#   cd ..\const-infra && docker compose --profile local-engines up -d
REDIS_URL=redis://127.0.0.1:6379

# MinIO / S3 (spec §10.4)
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=target-enterprise

# Production / private network examples (never expose engines to browsers):
# COST_CORE_BASE_URL=http://cost-core.internal:8069
# PM_CORE_BASE_URL=http://pm-core.internal:8080

